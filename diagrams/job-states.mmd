%% ============================================================
%% Диаграмма 7: State machine курса и джобы (актуальные enum'ы)
%% ============================================================
stateDiagram-v2
    direction LR
    state "Курс (courses.status)" as C {
        [*] --> draft: создан из брифа
        draft --> processing: POST /courses/{id}/run
        processing --> ready: worker завершил граф + версия
        processing --> failed: ошибка / валидация
        ready --> processing: повторный запуск (разрешён)
        failed --> processing: retry
        ready --> archived
        failed --> archived
        draft --> archived
        archived --> [*]
    }
    state "Джоба (jobs.status)" as J {
        [*] --> queued: создана
        queued --> running: worker start
        running --> completed: граф завершён
        running --> failed: исключение
        queued --> cancelled: отмена
        running --> cancelled: отмена
        completed --> [*]
        failed --> [*]
        cancelled --> [*]
    }