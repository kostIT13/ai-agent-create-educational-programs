%% ============================================================
%% Диаграмма 4: Схема БД (PostgreSQL)
%% Чанки референсов — в Qdrant, в Postgres — метаданные
%% ============================================================
erDiagram
    users ||--o{ courses : "создаёт"
    courses ||--o{ course_versions : "имеет версии"
    courses ||--o{ jobs : "запускает джобы"
    courses ||--o{ references : "загружает"
    courses ||--o{ feedback : "собирает отзывы"
    courses ||--o{ usage_log : "учитывает расход"
    jobs ||--o{ events : "порождает события"

    users {
        uuid id PK
        text email UK
        text role "admin | methodist | viewer"
        timestamp created_at
    }

    courses {
        uuid id PK
        uuid created_by FK
        text title
        jsonb brief_json "raw_brief + структурированный Brief"
        text status "draft | processing | ready | failed | archived"
        int version
        timestamp created_at
        timestamp updated_at
    }

    course_versions {
        uuid id PK
        uuid course_id FK
        int version
        jsonb graph_json "полный граф курса"
        jsonb diff_json "план: diff между версиями"
        int schema_version "план: версия схемы CourseGraph"
        timestamp created_at
    }

    jobs {
        uuid id PK
        uuid course_id FK
        text status "queued | running | completed | failed | cancelled"
        int progress "0..100"
        text error
        timestamp started_at
        timestamp finished_at
    }

    events {
        uuid id PK
        uuid job_id FK
        text node "имя узла графа"
        text status "started | running | completed | failed | interrupted"
        jsonb payload "артефакты узла"
        text mlflow_trace_id "план: связка с трейсом MLflow"
        timestamp ts
    }

    references {
        uuid id PK
        uuid course_id FK
        text name
        text mime
        text s3_key
        text qdrant_collection "course_{id}_refs"
        timestamp created_at
    }

    feedback {
        uuid id PK
        uuid course_id FK
        text entity_id "Q41 / S2 / L2..."
        int rating "1..5"
        text comment
        uuid created_by FK
        timestamp created_at
    }

    usage_log {
        uuid id PK
        uuid course_id FK
        text model
        int tokens_in
        int tokens_out
        numeric cost
        timestamp ts
    }