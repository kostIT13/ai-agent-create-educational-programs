%% ============================================================
%% Диаграмма 5: Доменная модель — единый граф курса
%% Constructive alignment: компетенция → результат → модуль → артефакты
%% ============================================================
flowchart LR
    B[Brief<br/>тема, аудитория, часы, требования]

    B --> C1[Компетенция C1]
    B --> C2[Компетенция C2]

    C1 --> LO1[Результат обучения LO1<br/>Bloom: apply]
    C1 --> LO2[Результат обучения LO2<br/>Bloom: analyze]
    C2 --> LO3[Результат обучения LO3<br/>Bloom: create]

    LO1 --> M1[Модуль M1]
    LO2 --> M1
    LO3 --> M2[Модуль M2]
    M1 --> M2["пререквизит"]

    M1 --> L1[Лекция L1<br/>план + слайды]
    M1 --> S1[Семинар S1<br/>задания + рубрика]
    M1 --> Q1[Вопросы Q11..Q18<br/>MCQ / open]

    M2 --> L2[Лекция L2]
    M2 --> S2[Семинар S2]
    M2 --> Q2[Вопросы Q21..Q25]

    Q1 -.->|оценивает| LO1
    S1 -.->|оценивает| LO2
    Q2 -.->|оценивает| LO3

    subgraph REFS["Источники (Qdrant)"]
        R1[Чанк R1] 
        R2[Чанк R2]
        R3[Чанк R3]
    end
    LO1 -.->|source_refs| R1
    LO2 -.->|source_refs| R2
    Q1 -.->|source_refs| R3

    style LO1 fill:#e3f2fd
    style LO2 fill:#e3f2fd
    style LO3 fill:#e3f2fd
    style Q1 fill:#fff3e0
    style Q2 fill:#fff3e0