%% ============================================================
%% Диаграмма 9: Поток данных — от брифа до готового курса
%% ============================================================
sequenceDiagram
    autonumber
    participant U as Пользователь
    participant FE as Frontend (React)
    participant API as FastAPI
    participant SVC as Сервисный слой
    participant WK as Worker (pipeline/worker.py)
    participant LG as LangGraph
    participant LLM as LLMClient
    participant MLF as MLflow

    U->>FE: бриф + референсы (PDF/URL)
    FE->>API: POST /courses {brief_json: {raw_brief}}
    API->>SVC: PipelineService.create_run()
    SVC-->>API: job_id (202)
    API-->>FE: JobRead
    API->>WK: background: run_job(job_id, course_id, raw_brief)
    WK->>LG: graph.astream(updates)
    loop по узлам: intake → competency → curriculum → validate
        LG->>LLM: structured output (Pydantic)
        LLM-->>LG: Brief / CompetencyPlan / ModulePlan
        LG-->>WK: update узла
        WK-->>API: Event (node, status, payload) + progress
        API-->>FE: SSE: /events/job/{id}/stream
        WK->>MLF: autolog: трейс + токены + стоимость
    end
    WK->>SVC: версия в course_versions + курс ready
    SVC-->>API: job completed
    API-->>FE: SSE: event done
    FE-->>U: граф курса готов