%% ============================================================
%% Диаграмма 2: Мультиагентный пайплайн (LangGraph)
%% Сделано: intake → competency → curriculum → validate (линейный)
%% План: + Reference Analyst, Send API, Critic-цикл, чекпоинты
%% ============================================================
flowchart TD
    S([Start]) --> INT[Intake<br/>разбор брифа → Brief]

    subgraph DONE["Сделано (Этап 2) — линейный граф"]
        INT --> COMP[Competency Architect<br/>компетенции + результаты обучения]
        COMP --> CURR[Curriculum Architect<br/>модули, часы, пререквизиты]
        CURR --> VAL[Validate<br/>детерминированные проверки]
        VAL -->|ошибки| ERR[errors в state → PipelineError]
        VAL -->|ok| NEXT
    end

    NEXT[Дальше по плану] --> REF[Reference Analyst<br/>Docling → Qdrant, извлечение требований]

    REF --> H1{interrupt 1:<br/>методист правит компетенции?}
    H1 -->|правки| COMP
    H1 -->|принято| H2{interrupt 2:<br/>методист правит структуру?}
    H2 -->|правки| CURR
    H2 -->|принято| SP[Send API: параллельно по модулям]

    SP --> AS[Assessment Designer<br/>тесты: MCQ / T-F / matching / open]
    SP --> SM[Seminar Designer<br/>задачи, кейсы, рубрики, эталоны]
    SP --> LC[Lecture Planner<br/>тайминг, тезисы, примеры, заметки]

    AS --> VIS[Visual Agent<br/>слайды PPTX + схемы]
    SM --> VIS
    LC --> VIS

    VIS --> CR[Critic / QA<br/>валидаторы + LLM-judge + fact-check]
    CR -->|замечания| DEC{Есть критические<br/>замечания?}
    DEC -->|да, ≤ 2 итерации| SP
    DEC -->|нет| PKG[Packager<br/>ZIP: PPTX, DOCX, Moodle XML, JSON]
    PKG --> E([End])