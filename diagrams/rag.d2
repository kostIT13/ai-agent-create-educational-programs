# ============================================================
# D2-тест: RAG-контур (альтернатива Mermaid)
# Рендер:  d2 --layout dagre diagrams/rag.d2 diagrams/rag.svg
# Установка: https://d2lang.com  (brew install d2 / install.sh)
# ============================================================
direction: right

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 200
  }
}

ingest: {
  label: "Ingest (один раз на курс)"
  pdf: "PDF"
  docx: "DOCX"
  pptx: "PPTX"
  url: "URL"
  docling: "Docling\nструктура документа"
  chunking: "Чанкинг по структуре\nсекции, таблицы, листы"
  metadata: "Метаданные чанка\nfile, section, page, source_type, date"
  embeddings: "bge-m3\ndense + sparse"
  qdrant: "Qdrant\ncourse_{id}_refs"

  pdf -> docling
  docx -> docling
  pptx -> docling
  url -> docling
  docling -> chunking: "markdown"
  chunking -> metadata
  metadata -> embeddings
  embeddings -> qdrant
}

search: {
  label: "Search (каждый запрос агента)"
  query: "Запрос агента\nпо своей задаче"
  hybrid: "Hybrid search\ndense + sparse, RRF"
  rerank: "bge-reranker-v2-m3"
  top6: "top-6 чанков"
  prompt: "Контекст в промпте\n<source id=...>"
  agent: "Агент"
  source_refs: "source_refs\ncourse_{id}_refs:{chunk_id}"

  query -> hybrid
  hybrid -> rerank: "top-30"
  rerank -> top6
  top6 -> prompt
  prompt -> agent
  agent -> source_refs
}

verify: {
  label: "Verify (Critic)"
  critic: "Утверждения следуют\nиз указанных чанков"
  chunk_exists: "chunk_exists: id валиден\nдетерминированно, без LLM"
}

search.source_refs -> verify.critic
search.source_refs -> verify.chunk_exists
ingest.qdrant -> search.prompt: "payload: text + metadata"

ingest.qdrant.style.fill: "#e3f2fd"
search.prompt.style.fill: "#fff3e0"
verify.critic.style.fill: "#fce4ec"