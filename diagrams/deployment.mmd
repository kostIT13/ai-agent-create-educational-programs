%% ============================================================
%% Диаграмма 8: Деплой (docker-compose) — локальная dev-среда
%% ============================================================
flowchart TB
    U[Пользователь] --> NG[Nginx :80<br/>static + proxy]

    subgraph DOCKER["docker compose up"]
        NG --> API[api :8000<br/>FastAPI + uvicorn]
        API --> LG[langgraph-worker<br/>тот же образ, фоновый процесс]
        API --> PG[(postgres :5432<br/>+ pgvector image)]
        API --> QD[(qdrant :6333)]
        API --> RD[(redis :6379)]
        API --> MMDC[mmdc<br/>Mermaid CLI контейнер]
        API --> LFU[langfuse :3000<br/>opcional, для трейсинга]
    end

    LG --> PG
    LG --> QD
    LG --> RD
    LG --> LLM[Внешние API:<br/>OpenAI / Anthropic / OpenRouter]

    subgraph CI["GitHub Actions (CI)"]
        direction LR
        LINT[lint + typecheck] --> TEST[pytest unit]
        TEST --> SMOKE[smoke: мини-бриф через пайплайн]
        SMOKE --> EVAL[evals: RAGAS + Promptfoo]
    end