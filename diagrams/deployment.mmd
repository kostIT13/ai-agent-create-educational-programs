%% ============================================================
%% Диаграмма 8: Деплой (docker-compose) — локальная dev-среда
%% ============================================================
flowchart TB
    U[Пользователь] --> API[api :8000<br/>FastAPI + uvicorn]

    subgraph DOCKER["docker compose up"]
        API --> PG[(postgres :5432<br/>данные + backend store MLflow)]
        API --> QD[(qdrant :6333<br/>чанки референсов)]
        API --> MLF[mlflow :5000<br/>backend store в Postgres,<br/>артефакты в volume]
        API --> MMDC[mmdc<br/>Mermaid CLI контейнер]
    end

    API --> LLM[Внешние API:<br/>OpenAI / Anthropic / OpenRouter]

    subgraph CI["GitHub Actions (CI)"]
        direction LR
        LINT[lint + typecheck] --> TEST[pytest unit]
        TEST --> SMOKE[smoke: мини-бриф через пайплайн]
        SMOKE --> EVAL["evals: MLflow<br/>recall@k + валидность source_refs<br/>+ регрессионный гейт"]
    end