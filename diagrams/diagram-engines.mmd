%% ============================================================
%% Диаграмма 12: Движки диаграмм для Visual Agent
%% Mermaid — по умолчанию; Graphviz — для DAG; D2 — опция
%% ============================================================
flowchart LR
    VA[Visual Agent<br/>JSON-структура визуала] --> E{Тип диаграммы}

    E -->|"Графы, mind-map,<br/>потоки (по умолчанию)"| MM[Mermaid<br/>mmdc в Docker, headless]
    E -->|"Архитектурные схемы,<br/>сложные связи"| D2[D2<br/>опция, когда Mermaid даёт «спагетти»]
    E -->|"Граф пререквизитов (DAG)"| GV[Graphviz dot<br/>раскладка DAG вне конкуренции]

    MM --> CACHE[Кэш рендеров<br/>hash(код диаграммы) → PNG в S3/MinIO]
    D2 --> CACHE
    GV --> CACHE
    CACHE --> EXP[PPTX / SVG / PNG]