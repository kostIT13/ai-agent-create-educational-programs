LOG_LEVEL=INFO
DEBUG=false

POSTGRES_URL=postgresql+asyncpg://User:Pass@postgres:5432/postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=Pass
POSTGRES_USER=User
POSTGRES_PORT=5432

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2

# RAG (Этап 4)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAG_EMBEDDINGS_PROVIDER=openai
RAG_EMBEDDINGS_MODEL=text-embedding-3-large
RAG_EMBEDDINGS_BASE_URL=
RAG_EMBEDDINGS_API_KEY=
RAG_EMBEDDINGS_DIM=1024
RAG_TOP_K=6
RAG_MAX_FILE_SIZE_MB=20
